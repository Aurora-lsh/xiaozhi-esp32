# Copy this file to .env and fill in the values. Never commit real secrets.
MCP_ENDPOINT=wss://replace-with-the-endpoint-from-xiaozhi.me

# Supported values: mimo, multipart, openai_compatible
VISION_API_STYLE=mimo

# Xiaomi MiMo multimodal API. Keep the real key only in .env.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
MIMO_MAX_COMPLETION_TOKENS=512
MIMO_VIDEO_ANALYSIS_FPS=2
MIMO_MEDIA_RESOLUTION=default

# These values are used only by the optional generic backends.
VISION_URL=https://replace-with-your-vision-service/analyze
VISION_TOKEN=

# Required only when VISION_API_STYLE=openai_compatible.
VISION_MODEL=

CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_WARMUP_FRAMES=3
CAMERA_JPEG_QUALITY=75
CAMERA_RECORD_FPS=10
VISION_TIMEOUT_SECONDS=30
