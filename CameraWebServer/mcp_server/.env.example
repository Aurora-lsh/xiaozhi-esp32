# Copy the complete MCP_ENDPOINT from the working vision-mcp/.env.
# The bridge reports connection status and logs back to the registered camera so the
# device web page (http://<ESP32-IP>/) shows MCP status and capture events.
MCP_ENDPOINT=wss://replace-with-the-endpoint-from-xiaozhi.me
# Dynamic registration: use the same key in mcp_registration_config.h.
CAMERA_REGISTRATION_HOST=0.0.0.0
CAMERA_REGISTRATION_PORT=8765
CAMERA_REGISTRATION_KEY=replace-with-a-long-random-key
# Optional fallback for old firmware; leave blank for registration-only mode.
ESP32_BASE_URL=
ESP32_TIMEOUT_SECONDS=100
# 建立 TCP 连接的等待秒数（默认 8）。手机热点常有数秒级瞬时黑洞，
# 太短会把网络抖动误判成“设备离线”。
ESP32_CONNECT_TIMEOUT_SECONDS=8
WATCH_SAMPLE_INTERVAL_SECONDS=1
